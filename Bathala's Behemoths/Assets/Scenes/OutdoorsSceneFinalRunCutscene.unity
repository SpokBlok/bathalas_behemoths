--- !u!114 &338102109
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 338102104}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 94af4cb054f807545b87f388137e60a3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textComponent: {fileID: 1893314894}
  lines:
  - '*Dwende Mom comes out with Dwende Kids hiding behind her*'
  - 'Dwende Mom: Yes? Can I help you?'
  - 'Steve: Hello, uh, we were asked to check up on a dwende family living here?
    By a dwende building a hut near the shoreline.'
  - 'Dwende Mom: Oh dear, how is he? Did he get caught in the huge tidal wave? '
  - "Steve: Tidal wave? No, he just experienced the earthquake. His new hut wasn\u2019t
    safe though\u2026"
  - 'Dwende Kid: Yaaa the big black wave came and walked away hahaha'
  - "Steve: The wave\u2026 walked? "
  - "Dwende Mom: Yes, well, there was a big wave that came during the earthquake.
    There was a black\u2026 thing\u2026 under the water, moving away, slowly disappearing."
  - 'Steve: Alright, thanks for the information.'
  - "Dwende Mom: No worries, do tell that son of mine to come back soon if you see
    him. I\u2019m still worried about him leaving on his own."
  linesRepeat:
  - 'Dwende Kid: Hallo!'
  - "Dwende Mom: Do tell that son of mine to come back soon if you see him. I\u2019m
    still worried about him living on his own."
  currentLines: []
  textInterval: 0.03
  pointer: {fileID: 1184914741}
  HUD: {fileID: 0}
