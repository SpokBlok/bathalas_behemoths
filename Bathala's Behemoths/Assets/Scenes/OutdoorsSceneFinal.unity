--- !u!114 &1456450254
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1456450249}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dd95f25ef12578c48a1b9c57771dc093, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textComponent: {fileID: 216625541}
  lines:
  - '*Steve and Manny spot a disgruntled old dwende farmer and walk up to him and
    his seemingly dead field of crops*'
  - 'Old Farmer Dwende: *Mumble mumble* ... stupid... *grumble grumble*'
  - 'Steve: Hey, old timer! What''s got you grumbling about like that?'
  - "Manny: Look around, Steve, his crops aren't growing\u2026"
  - 'Old Farmer Dwende: You got that right! This land just isn''t fertile enough
    for growing crops all season long!! At this rate, I''ll go broke!'
  - 'Old Farmer Dwende: That young whippersnapper down the road sure has it good.
    His crops are growing like daisies. I just KNOW he''s using some sort of trick
    to get his crops to flourish. '
  - "Old Farmer Dwende: You know what? Now that you're here, why don't you do this
    old dwende a favor and do a little sneakin\u2019 for me? Whadd'ya say? All you
    have to do is find out what that young'n's secret trick is. His farm's just down
    this road; you can't miss it!"
  - 'Steve: *Looks at Manny*'
  - 'Manny: *Looks at Steve*'
  - 'Steve: Uh, sure. If it helps keep your farm afloat.'
  - 'Manny: I''m sure the young farmer will want to help! Bayanihan, and all.'
  - "Old Farmer Dwende: He better! I've been smelling something in the air ever since
    he came down from the mountain a couple of weeks ago, that\u2019s just gotta
    be it!!"
  - 'Steve: Huh. That''s... weird. We''ll go check it out!'
  linesRepeat:
  - 'Old Farmer Dwende: I swear... that whippersnapper''s doing something weird with
    his crops. I can''t even get mine to grow!!'
  - 'Old Farmer Dwende: You''re still here?! Go! Get me that rascal''s secrets so
    I can get my farm back in order!'
  currentLines: []
  textInterval: 0.03
  pointer: {fileID: 1666725356}
  HUD: {fileID: 0}
