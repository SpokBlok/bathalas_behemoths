  m_Script: {fileID: 11500000, guid: dafa0bf6645eedf49be880b6054b5ac5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textComponent: {fileID: 1423496524}
  lines:
  - "Steve: Burnt to a crisp\u2026"
  - "Manny: That Frightened Dwende won\u2019t be napping here anytime soon."
  - 'Steve: Well, it does look like it was hit by lightning, but what were those
    rocks the Frightened Dwende mentioned?'
  - "Manny: Maybe those weren't rocks\u2026"
  - "Manny: Oh hey, there\u2019s a mud patch here that seems untouched\u2026 oh!"
  - "Manny: There\u2019s an untouched tulip here!"
  - 'Steve: How did it withstand the lightning strike?'
  linesRepeat:
  - 'Manny: We should leave the area before more BLINKING rocks smite this tree with
    lightning. Let''s keep investigating!'
  - "Steve: The mud neutralized the lightning\u2026"
  currentLines: []
  textInterval: 0.03
  pointer: {fileID: 712244224}
  HUD: {fileID: 0}
