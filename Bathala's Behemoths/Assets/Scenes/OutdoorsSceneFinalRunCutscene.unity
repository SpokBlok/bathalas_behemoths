--- !u!114 &969841174
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 969841173}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 43971a89417544e4c899ce1b62d167ac, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textComponent: {fileID: 2144480841}
  lines:
  - ' Steve: Uhh, are you okay down there? '
  - "Despondent Dwende: \u2026 "
  - "Steve: \u2026"
  - "Manny: \u2026"
  - "Despondent Dwende: \u2026 "
  - "Despondent Dwende: Oh hey. Didn\u2019t expect visitors\u2026 I would offer some
    fruits but\u2026"
  - "Steve: It\u2019s\u2026 all good. How\u2019d this all end up happening?"
  - "Despondent Dwende: Well, I wanted to set up my own hut by the shore so I could
    collect seashells.. I was almost done, so I went to go back to my family\u2019s
    house to grab the rest of my seashells. "
  - "Despondent Dwende: But when I entered the forest, the ground suddenly started
    shaking. I got worried and decided to run back. What you see now is what I returned
    to\u2026 "
  - 'Steve: Sorry to hear that. Can we get you some help?'
  - 'Despondent Dwende: ...'
  - "Despondent Dwende: Sorry to bother you, but could I ask you to check up on my
    family? I\u2019m a little worried they might have been hit by the earthquake
    too. I need some time to clean up and figure out my next steps. "
  - "Despondent Dwende: My family\u2019s house is over in the SOUTHWEST, on HIGHER
    GROUND - please make sure they\u2019re safe! "
  linesRepeat:
  - "Despondent Dwende: \u2026 What to do now\u2026"
  - 'Despondent Dwende: Oh hey, you''re still here... please find my family soon!
    I''m getting worried... they went to our home in the SOUTH trying to head to
    HIGHER GROUND.'
  currentLines:
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  - 
  textInterval: 0.03
  HUD: {fileID: 0}
