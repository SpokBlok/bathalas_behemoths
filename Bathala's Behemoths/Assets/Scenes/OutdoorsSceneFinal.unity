--- !u!114 &274606201
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 274606196}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 481f3e1823996ce4289b8e5be20bc345, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textComponent: {fileID: 1123508261}
  lines:
  - 'Steve: This must be the chest with the bottles of powdered scales.'
  - "Manny: This \u201Cfertilizer\u201D might just be poisoning the young farmer\u2019s
    crops if his field looks even worse than the old farmer's field\u2026"
  - 'Manny: But why would the farmer think his field was lush and green when it''s
    so... dead?'
  - 'Steve: Since the old farmer also had the same things to say about this field,
    I think it''s safe to say that there''s some sort of POWER making them HALLUCINATE
    about the state of this field.'
  - "Manny: Is that right? We have to steer clear of whoever these scales belong
    to\u2026"
  - 'Steve: Yeah, at least until we can learn more about it.'
  linesRepeat:
  - 'Manny: We already have the bottle of powdered scales. We should keep investigating
    elsewhere.'
  currentLines: []
  textInterval: 0.03
  pointer: {fileID: 875123617}
  HUD: {fileID: 0}
