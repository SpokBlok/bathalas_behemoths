  m_Name: 
  m_EditorClassIdentifier: 
  textComponent: {fileID: 1921008765}
  lines:
  - "Manny: FINALLY!! Look, Steve, we caught the chicken! Here, it looks like something's
    laced over its feathers\u2026"
  - 'Steve: It looks BEWILDERED. I think you should let it go, Manny!'
  - '*Manny drops the chicken abruptly*'
  - 'Steve: It may have been poisoned or something - we should leave this place in
    case the thing that attacked it is still around.'
  linesRepeat:
  - 'Steve: I think this chicken may have been attacked.'
  - 'Manny: Yeah, these woods are dangerous. We should keep investigating.'
  - 'Steve: Right.'
  currentLines: []
  textInterval: 0.03
  pointer: {fileID: 1767634623}
