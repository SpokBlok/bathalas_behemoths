  m_Name: 
  m_EditorClassIdentifier: 
  textComponent: {fileID: 507999892}
  lines:
  - 'Steve: This chest looks like it holds something valuable, right Manny?'
  - 'Manny: Let''s open it!!'
  - 'Steve: Right on the money, it''s the flute!'
  - 'Manny: I do wonder why so many kapres were protecting a simple looking flute.'
  - "Steve: Hm, maybe there\u2019s something special about it that the happy dwende
    isn\u2019t letting us know about?"
  - "Manny: Let\u2019s question him about the flute."
  linesRepeat:
  - 'Manny: We should take this back to the Happy Dwende near the forest''s entrance.'
  currentLines: []
  textInterval: 0.03
  pointer: {fileID: 1753076356}
  HUD: {fileID: 0}
