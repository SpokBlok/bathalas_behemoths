  m_EditorClassIdentifier: 
  textComponent: {fileID: 634404449}
  currentLines:
  - The Markupo flails about, but is swiftly subdued by Manny and Steve.
  - Exhausted, the Markupo shrinks to fit in the palm of your hand..
  - The moment it ran out of strength, its illusory magic wore off...
  - Revealing its true form.
  - Its worshippers - the kapres - having been disillusioned, fled.
  textInterval: 0.03
  pointer: {fileID: 1651247985}
