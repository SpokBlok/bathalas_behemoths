--- !u!114 &2065475824
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2065475820}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 058429c6fad779a4c911c2b99a2d72ca, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textComponent: {fileID: 1582496077}
  lines:
  - "*Manny walks up to Frightened Dwende, who is facing away and hasn\u2019t noticed
    him *"
  - "Frightened Dwende: \u2026 (focused on something in the distance) "
  - '*Frightened Dwende suddenly turns around *'
  - 'Frightened Dwende: AAAAHH!!'
  - 'Steve & Manny: AAAAAHH!!'
  - '*Manny immediately enters a fighting stance*'
  - "Frightened Dwende: Geez! You can\u2019t be sneaking up behind people like that!
    I\u2019ve had enough spooks for one day\u2026"
  - "Steve: \"Spooks? What\u2019s got you so scared that you\u2019re hiding out here?\" "
  - "Frightened Dwende: Well, I was sleeping beside a tree and just woke up, but
    as soon as I got up, the tree instantly got struck by lightning! Someone\u2019s
    out to get me, I\u2019m sure of it! "
  - 'Steve: Huh, where did the lightning even come from?'
  - '*Manny relaxes*'
  - 'Frightened Dwende: You tell me! I just saw these two rocks shaking a bunch and
    then BAM! LIGHTNING! Oh gods, what if the whole forest is after me?'
  - 'Steve: Would you mind pointing me over to where this struck tree is at?'
  - 'Frightened Dwende: See that tree to the SOUTH? That was my favorite nap spot,
    and now it''s gone... *sobs*'
  linesRepeat:
  - 'Steve: Where did you say the lightning struck again?'
  - 'Frightened Dwende: Just over there, to the SOUTH. You can''t miss it!'
  - 'Frightened Dwende: My favorite nap spot... those BLINKING rocks ruined my nap
    spot... *sobs*'
  currentLines: []
  textInterval: 0.03
  pointer: {fileID: 1410925912}
  HUD: {fileID: 0}
