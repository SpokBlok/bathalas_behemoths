--- !u!114 &272797890
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 272797888}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3600d32b78e58994fbe6b85b2cbb79b0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textComponent: {fileID: 203136148}
  lines:
  - '*Steve and Manny encounter a broken fence on the ground and inspect it*'
  - 'Steve: Hey Manny, I think there''s something on the ground here. '
  - "Manny: Huh? Looks like it just washed up on the riverbank\u2026"
  - 'Steve: I bet we''ll find where this came from further downstream. Let''s go
    check it out, someone might need our help!'
  - "Manny: I think I see something by the beach\u2026"
  linesRepeat:
  - 'Steve: We should go FURTHER UP THE RIVER until we get to the BEACH and see what
    we can find.'
  currentLines: []
  textInterval: 0.03
  pointer: {fileID: 186700277}
  HUD: {fileID: 0}
